# Server
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost,http://localhost:8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=itresolve
DB_PASSWORD=change_me
DB_NAME=itresolve

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Gmail SMTP (use a Google App Password, not your normal Gmail password)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=your-gmail-address@gmail.com
FRONTEND_URL=https://adlresolve.netlify.app/
